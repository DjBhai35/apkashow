<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Serve clean sitemap.xml via PHP generator
RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]

# Clean Category URLs: /category/millionaire -> category.php?slug=millionaire
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ category.php?slug=$1 [L,QSA]

# Clean Movie URLs: /movie/the-wolf-of-wall-street -> movie.php?slug=the-wolf-of-wall-street
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^movie/([a-zA-Z0-9_-]+)/?$ movie.php?slug=$1 [L,QSA]

</IfModule>

# Security Hardening for Shared Hosting / cPanel
# Prevent directory browsing
Options -Indexes

# Protect sensitive files and sql dumps
<FilesMatch "(^\.env|config\.php|schema\.sql|\.git|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable Gzip Compression for Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
